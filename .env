############################################################
# CreativeWriter Self-Hosted Configuration
############################################################

# ⚠️  The defaults below are for LOCAL DEVELOPMENT ONLY.
# For production, run ./setup.sh to generate fresh secrets.

# === REQUIRED ===

# PostgreSQL password — use a strong random string
POSTGRES_PASSWORD=your-super-secret-and-long-postgres-password

# JWT secret — minimum 32 characters, used by all Supabase services
JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long

# Supabase anonymous key — HS256 JWT signed with JWT_SECRET (role=anon, expires 2039)
ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoiYW5vbiIsImlzcyI6InN1cGFiYXNlIiwiaWF0IjoxNzAwMDAwMDAwLCJleHAiOjIyMDAwMDAwMDB9.C4nk64cP61I2fXQKo7ks7jJt8Wr3Q-WjDx2dobxAMPU

# Supabase service role key — HS256 JWT signed with JWT_SECRET (role=service_role, expires 2039)
SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoic2VydmljZV9yb2xlIiwiaXNzIjoic3VwYWJhc2UiLCJpYXQiOjE3MDAwMDAwMDAsImV4cCI6MjIwMDAwMDAwMH0.W5YLNTzJwKrHTuLkF4R_vZpngyMh5jf4Reo_upRMQlQ

# Public-facing URL where the app is accessible
# This is used for auth redirects, CORS, and API routing
SUPABASE_PUBLIC_URL=http://localhost:3000

# Port the frontend listens on (maps to nginx container port 80)
FRONTEND_PORT=3000

# === SMTP (required for signup confirmation and password reset) ===
# Set MAILER_AUTOCONFIRM=true to skip email confirmation (dev only)

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASS=your-smtp-password
SMTP_SENDER_EMAIL=noreply@example.com
MAILER_AUTOCONFIRM=true

# === PREMIUM FEATURES (license key) ===
# Self-hosted is single-tenant by design. Premium features (AI Rewrite,
# Character Chat, AI Portrait Generation) unlock via a license key generated
# on creativewriter.dev — there is no local Stripe path.
#
# Per-user keys entered in Settings > Premium > License Key take precedence.
# The LICENSE_KEY env var below is an optional server-wide fallback that grants
# premium to every user on this instance.
#
# How to obtain a key: subscribe at https://creativewriter.dev, open the
# billing page, click "Generate license key", and either paste it into
# Settings > Premium on this instance or set LICENSE_KEY here.
LICENSE_KEY=

# NOTE: Included AI (DeepSeek) is NOT available on self-hosted instances.
# This key has no effect — it is only used by the hosted version.
DEEPSEEK_API_KEY=

# === LOCAL AI FOR DEEP WRITER (self-hosted only) ===
# The Deep Writer pipeline runs SERVER-SIDE, inside the `functions` container, so
# it cannot reach the browser-side Ollama URL you set in Settings > AI Providers.
# These variables are that container's address for your model server. Both are
# EMPTY by default: leave them unset and nothing changes — Deep Writer keeps
# offering OpenRouter only, and a local slot answers 400 naming the variable.
#
# Pick the line that matches where your model server runs:
#   1. On the Docker host       OLLAMA_BASE_URL=http://host.docker.internal:11434
#   2. A sibling container      OLLAMA_BASE_URL=http://ollama:11434
#      (it must join the `creativewriter` network)
#   3. Another machine on the LAN
#                               OLLAMA_BASE_URL=http://192.168.1.50:11434
#
# All of `http://h:11434`, `.../v1` and `.../v1/chat/completions` are accepted.
#
# PREREQUISITE for Ollama: start the server with OLLAMA_HOST=0.0.0.0:11434 (so the
# container can reach it) and OLLAMA_CONTEXT_LENGTH=16384. Deep Writer uses the
# OpenAI-compatible /v1 endpoint, which has no per-request num_ctx — the in-app
# "Context Window" setting does NOT apply to it, so Ollama's silently-truncating
# 4096-token default is what you get otherwise. Verify with `ollama ps`.
#
# OLLAMA_BASE_URL=http://host.docker.internal:11434
# OLLAMA_API_KEY=              # only if Ollama sits behind an authenticating proxy
#
# LM Studio / vLLM / llama.cpp — same idea, separate variables:
# OPENAI_COMPATIBLE_BASE_URL=http://host.docker.internal:1234/v1
# OPENAI_COMPATIBLE_API_KEY=   # e.g. vLLM's --api-key; the in-app key is NOT used

# === SUPABASE STUDIO (database admin UI) ===
# Studio starts automatically on port 54323, bound to localhost only.
# Access it at http://localhost:54323 (use SSH tunnel for remote servers).
STUDIO_PORT=54323

# === SIGNUP CONTROL ===
# Set to true to disable new user registration (useful after creating your accounts)
# DISABLE_SIGNUP=false

# === IMAGE PROXY ===
# Only set this if you run imgproxy (docker compose --profile imgproxy up -d)
# IMGPROXY_URL=http://imgproxy:8080

# === SECURITY (recommended for production) ===
# These have hardcoded defaults that work out of the box, but should be
# changed for any publicly accessible deployment.

# Realtime session secret — generate with: openssl rand -base64 32
# SECRET_KEY_BASE=

# Realtime database encryption key — generate with: openssl rand -hex 8
# (16 bytes for AES-128-ECB; -hex 16 produces a 32-byte string and crashes Realtime.)
# DB_ENC_KEY=

# === ADVANCED ===
# POSTGRES_PORT=5432
# Disable Deno module caching (true = redownload on each cold start).
# Set to false for faster cold starts once functions are stable.
NO_MODULE_CACHE=true
